# Google Sheets data source
# ID of the Google Sheet (the <id> in https://docs.google.com/spreadsheets/d/<id>/edit)
GOOGLE_SHEET_ID=""
# Service account JSON (on a single line) used to read the sheet.
# The sheet must be shared (Viewer) with the service account's client_email.
GOOGLE_API_JSON=''

# Public site URL (used for OG metadata and image URLs)
SITE_URL="https://in-flames-closet.kiriancaumes.fr"

# API key required for the image upload endpoint (POST /api/image)
API_KEY=""

# Google Analytics 4 measurement ID (optional - shown to user on cookie accept)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=""
